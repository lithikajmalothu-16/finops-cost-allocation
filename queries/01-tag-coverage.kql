// Tag coverage: how much spend can be attributed from tags alone?
// Splits total cost into Tagged / Untagged / Shared.
// Result: 40.4% tagged, 18.2% untagged, 41.4% shared.

AzureBilling_CL
| extend Bucket = case(
    ResourceGroup == "rg-shared-services", "Shared",
    isnotempty(tostring(parse_json(Tags).cost_center)), "Tagged",
    "Untagged")
| summarize Cost = round(sum(CostInBillingCurrency), 2) by Bucket
| extend Pct = round(100.0 * Cost / toscalar(
    AzureBilling_CL | summarize sum(CostInBillingCurrency)), 1)
| order by Cost desc
