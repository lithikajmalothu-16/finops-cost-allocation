// Owner inference: assign an owner to untagged-but-ownable spend.
// Explicit tags always win; resource-group naming is the fallback.
// The Confidence column keeps "declared" separate from "inferred" —
// a chargeback report that hides that distinction won't survive review.
// Result: 7 rows. UNRESOLVED/Shared ≈ $44,492 is the pool allocation solves.

AzureBilling_CL
| extend CostCenterTag = tostring(parse_json(Tags).cost_center)
| extend Owner = case(
    isnotempty(CostCenterTag), CostCenterTag,
    ResourceGroup startswith "rg-storefront", "Storefront",
    ResourceGroup startswith "rg-data-platform", "Merchandising",
    ResourceGroup == "rg-corp-it", "Corporate",
    "UNRESOLVED")
| extend Confidence = case(
    isnotempty(CostCenterTag), "Tagged",
    ResourceGroup == "rg-shared-services", "Shared",
    "Inferred")
| summarize Cost = round(sum(CostInBillingCurrency), 2) by Owner, Confidence
| order by Owner asc, Cost desc
